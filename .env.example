# ===== 飞书应用（开放平台 → 你的自建应用 → 凭证与基础信息）=====
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_key_here

# ===== 大模型（OpenAI 兼容接口）=====
# DeepSeek 官方
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=deepseek-chat

# 其他可选（改 base_url / model 即可）
# 通义     https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# Moonshot https://api.moonshot.cn/v1                          moonshot-v1-8k
# 本地Ollama http://127.0.0.1:11434/v1                          qwen2.5:7b

LLM_TEMPERATURE=1.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# ===== 机器人行为 =====
# 人设：留空则用内置的简短助理人设
SYSTEM_PROMPT=
MAX_HISTORY_TURNS=10
# 群里是否必须 @ 机器人才回复
GROUP_REQUIRE_MENTION=true
MAX_WORKERS=4

# ===== 日志 =====
LOG_LEVEL=INFO
LOG_FILE=bot.log